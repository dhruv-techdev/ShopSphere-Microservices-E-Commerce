# Rendered by the nginx image's envsubst step (only ${API_GATEWAY_URL} is substituted).
server {
    listen      80;
    server_name _;

    root  /usr/share/nginx/html;
    index index.html;

    server_tokens off;
    client_max_body_size 10m;

    # Docker's embedded DNS: re-resolve api-gateway if its container is recreated.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api_gateway ${API_GATEWAY_URL};

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Same-origin API: the browser never talks to the gateway directly, so no CORS needed.
    location /api/ {
        proxy_pass $api_gateway;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";
        proxy_connect_timeout 5s;
        proxy_read_timeout    60s;
    }

    location = /index.html {
        expires -1;
    }

    location ~* \.(?:js|css|woff2?|ttf|svg|png|jpg|jpeg|webp|ico)$ {
        expires 1y;
        access_log off;
        try_files $uri =404;
    }

    # SPA fallback: deep links like /dashboard are served index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
